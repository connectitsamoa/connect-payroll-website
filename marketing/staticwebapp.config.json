{
  "routes": [
    { "route": "/assets/fonts/*", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "route": "/assets/hero.js", "headers": { "Cache-Control": "public, max-age=3600" } },
    { "route": "/assets/*", "headers": { "Cache-Control": "public, max-age=604800" } },
    { "route": "/styles.css", "headers": { "Cache-Control": "public, max-age=3600" } }
  ],
  "mimeTypes": {
    ".woff2": "font/woff2"
  },
  "globalHeaders": {
    "Content-Security-Policy": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'",
    "Permissions-Policy": "camera=(), geolocation=(), microphone=()",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY"
  }
}
